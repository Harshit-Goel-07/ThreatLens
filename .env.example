# =============================================================================
# Security Copilot - environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit your .env.
#
# Generate strong secrets:
#   JWT_SECRET_KEY :  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   API_KEYS       :  python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# --- Runtime environment -----------------------------------------------------
# development | staging | production
# In "production" the app refuses to start with placeholder/weak secrets.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM provider ------------------------------------------------------------
# openai | ollama
LLM_PROVIDER=openai
# Set true to use OpenAI embeddings (1536-d) instead of the local model (384-d).
USE_OPENAI_EMBEDDINGS=false

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama (optional local models) ------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Vector database (Qdrant) ------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_HTTPS=false

# --- PostgreSQL --------------------------------------------------------------
# Either set POSTGRES_URL directly, or the individual parts below.
POSTGRES_URL=
POSTGRES_USER=seccopilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=seccopilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (caching + rate-limit backend) ------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# --- Authentication ----------------------------------------------------------
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Comma-separated list of service API keys accepted via the X-API-Key header.
API_KEYS=
# Optional bootstrap admin account created on first startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS / security ---------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT=60/minute
MAX_REQUEST_BYTES=1048576

# --- Ingestion ---------------------------------------------------------------
MITRE_DATA_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# Optional NVD API key for higher rate limits (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
INGESTION_BATCH_SIZE=100

# --- Retrieval ---------------------------------------------------------------
DEFAULT_TOP_K=10
RERANK_TOP_K=5
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_QUERY_LENGTH=5000
